# Imagen de PRODUCCIÓN: el código va dentro de la imagen (nada de montar carpetas del servidor), sin composer ni herramientas de desarrollo.
# Se construye con:  docker compose -f docker-compose.prod.yml build

# ---- 1) dependencias de PHP, sin paquetes de desarrollo
FROM composer:2 AS dependencias
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --no-interaction --prefer-dist
COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction

# ---- 2) imagen final
FROM php:8.4-fpm-alpine

RUN apk add --no-cache icu-libs libzip postgresql-libs \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev libzip-dev postgresql-dev \
    && docker-php-ext-install -j"$(nproc)" bcmath intl opcache pcntl pdo_pgsql pgsql zip \
    && apk del .build-deps

COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/zz-easylunch.ini
COPY docker/php/fpm.prod.conf /usr/local/etc/php-fpm.d/zz-easylunch.conf
COPY docker/php/entrypoint-prod.sh /usr/local/bin/entrypoint-prod
RUN chmod +x /usr/local/bin/entrypoint-prod

WORKDIR /var/www/html
COPY --from=dependencias --chown=www-data:www-data /app ./
# Lo que escribe Laravel en ejecución vive en el volumen `storage` (se monta encima) y en una carpeta temporal.
RUN mkdir -p storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && php artisan package:discover --ansi

USER www-data
ENTRYPOINT ["entrypoint-prod"]
CMD ["php-fpm"]
