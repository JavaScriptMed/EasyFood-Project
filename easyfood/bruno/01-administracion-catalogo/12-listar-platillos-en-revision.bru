meta {
  name: Listar platillos en revisión
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/admin/platillos?estado_revision=en_revision
  body: none
  auth: bearer
}

params:query {
  estado_revision: en_revision
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("todos están en revisión", function () {
    res.body.forEach(p => expect(p.estado_revision).to.equal("en_revision"));
  });
}
