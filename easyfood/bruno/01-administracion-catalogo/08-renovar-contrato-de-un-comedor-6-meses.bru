meta {
  name: Renovar contrato de un comedor (6 meses)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/comedores/{{comedorSurId}}/renovar-contrato
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("el contrato sigue activo", function () {
    expect(res.body.dias_para_vencer).to.be.greaterThan(100);
  });
}
