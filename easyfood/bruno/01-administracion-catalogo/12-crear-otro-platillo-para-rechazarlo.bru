meta {
  name: Crear otro platillo (para rechazarlo)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/admin/platillos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "comedor_id": "{{comedorSurId}}",
    "nombre": "Otro platillo de prueba {{$timestamp}}",
    "tiempo_comida": "cena",
    "precio_venta": 49,
    "estado_revision": "en_revision"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("platilloNuevo2Id", res.body.id);
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
