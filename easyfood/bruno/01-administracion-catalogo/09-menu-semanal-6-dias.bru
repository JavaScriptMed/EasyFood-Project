meta {
  name: Menú semanal (6 días)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/admin/menu-semanal?fecha_inicio={{lunesProximo}}
  body: none
  auth: bearer
}

params:query {
  fecha_inicio: {{lunesProximo}}
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("seis días con un platillo por tiempo de comida", function () {
    expect(res.body.length).to.equal(6);
    expect(res.body[0]).to.have.property("celdas");
  });
}
