meta {
  name: Elegir un platillo
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/platillos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200 && res.body.length) bru.setVar("platilloFotoId", res.body[0].id);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
