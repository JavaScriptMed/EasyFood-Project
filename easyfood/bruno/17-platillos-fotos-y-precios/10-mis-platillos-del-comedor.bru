meta {
  name: Mis platillos (comedor)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/comedor/platillos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenComedor}}
}

script:post-response {
  if (res.status === 200 && res.body.length) bru.setVar("platilloPropioId", res.body[0].id);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
