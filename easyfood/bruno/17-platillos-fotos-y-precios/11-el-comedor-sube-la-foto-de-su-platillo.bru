meta {
  name: El comedor sube la foto de su platillo
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/comedor/platillos/{{platilloPropioId}}/imagen
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tokenComedor}}
}

body:multipart-form {
  imagen: @file(17-platillos-fotos-y-precios/plato.png)
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("la foto nueva pasa por revisión", function () {
    expect(res.body.foto_url).to.include("/storage/platillos/");
    expect(res.body.estado_revision).to.be.oneOf(["en_revision", "borrador"]);
  });
}

docs {
  Si el platillo estaba publicado o rechazado vuelve a revisión, igual que al editarlo.
}
