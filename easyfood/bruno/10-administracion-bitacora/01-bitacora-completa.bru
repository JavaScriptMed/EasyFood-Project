meta {
  name: Bitácora completa
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/bitacora
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("hay registros con su autor", function () {
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0]).to.have.property("usuario_nombre");
  });
}

docs {
