meta {
  name: No entregada sin motivo rechazado
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/repartidor/paradas/{{paradaDosId}}/no-entregada
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

body:json {
  {}
}

tests {
  test("responde 422 con el error del motivo (si hay segunda parada)", function () {
    if (!bru.getVar("paradaDosId")) return;
    expect(res.getStatus()).to.equal(422);
    expect(res.body.errores).to.have.property("motivo");
  });
}
