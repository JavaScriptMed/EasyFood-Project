meta {
  name: Confirmar la entrega con foto de evidencia
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/repartidor/paradas/{{paradaUnoId}}/entregar
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

body:multipart-form {
  foto: @file(20-api-del-repartidor/evidencia.png)
}

tests {
  test("responde 200 con la parada entregada", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.parada.estado).to.equal("entregado");
    expect(res.body.parada.cerrada_en).to.be.a("string");
  });

  test("guardó la foto de evidencia", function () {
    expect(res.body.parada.evidencia_foto_url).to.include("/storage/evidencias/");
    expect(res.body.parada.evidencia_foto_url).to.match(/\.png$/);
  });

  test("ya se puede iniciar la siguiente", function () {
    if (bru.getVar("paradaDosId")) {
      expect(res.body.ruta.siguiente_parada_id).to.equal(Number(bru.getVar("paradaDosId")));
      expect(res.body.ruta.paradas_cerradas).to.equal(1);
    }
  });
}

docs {
  Foto JPG, PNG o WebP de hasta 5 MB en el campo `foto` (multipart). Se guarda con un nombre aleatorio. El pedido del cliente queda «completado».
}
