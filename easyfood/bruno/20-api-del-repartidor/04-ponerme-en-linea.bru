meta {
  name: Ponerme en línea
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/repartidor/disponibilidad
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

body:json {
  { "en_linea": true }
}

tests {
  test("responde 200 en línea", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.en_linea).to.equal(true);
    expect(res.body.estado).to.equal("libre");
  });
}
