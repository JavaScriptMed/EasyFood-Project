meta {
  name: La incidencia le llega al administrador
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/admin/incidencias?abiertas=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200 y hay una entrega no localizada abierta (si hubo segunda parada)", function () {
    expect(res.getStatus()).to.equal(200);
    if (!bru.getVar("paradaDosId")) return;
    const lista = Array.isArray(res.body) ? res.body : res.body.incidencias;
    const i = lista.find(x => x.tipo === "entrega_no_localizada" && x.descripcion.includes("Nadie abrió la puerta"));
    expect(i).to.not.equal(undefined);
    expect(i.estado).to.equal("abierta");
    expect(i.prioridad).to.equal("inmediata");
  });
}
