meta {
  name: Marcar la parada como no entregada con un motivo
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/repartidor/paradas/{{paradaDosId}}/no-entregada
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

body:json {
  { "motivo": "Nadie abrió la puerta" }
}

tests {
  test("responde 200 con la parada no localizada y su motivo (si hay segunda parada)", function () {
    if (!bru.getVar("paradaDosId")) return;
    expect(res.getStatus()).to.equal(200);
    expect(res.body.parada.estado).to.equal("no_localizado");
    expect(res.body.parada.motivo_no_entrega).to.equal("Nadie abrió la puerta");
    expect(res.body.parada.evidencia_foto_url).to.equal(null);
  });
}

docs {
  Deja una incidencia abierta («entrega_no_localizada») para que el administrador la atienda.
}
