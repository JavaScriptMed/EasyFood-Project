meta {
  name: Iniciar la primera parada (la ruta pasa a en curso)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/repartidor/paradas/{{paradaUnoId}}/iniciar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

tests {
  test("responde 200 con la parada en camino", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.parada.estado).to.equal("en_camino");
    expect(res.body.parada.iniciada_en).to.be.a("string");
  });

  test("la ruta quedó en curso", function () {
    expect(res.body.ruta.estado).to.equal("en_curso");
    expect(res.body.ruta.siguiente_parada_id).to.equal(res.body.parada.id);
  });
}
