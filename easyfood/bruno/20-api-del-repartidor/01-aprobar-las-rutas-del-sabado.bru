meta {
  name: El administrador aprueba las rutas del sábado
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/rutas/aprobar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  { "fecha": "{{sabadoDeEntrega}}" }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  El repartidor solo ve las rutas aprobadas: en borrador todavía no hay nada que hacer.
}
