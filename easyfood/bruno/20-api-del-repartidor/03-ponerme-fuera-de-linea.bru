meta {
  name: Ponerme fuera de línea
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/repartidor/disponibilidad
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRepartidor}}
}

body:json {
  { "en_linea": false }
}

tests {
  test("responde 200 fuera de línea", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.en_linea).to.equal(false);
    expect(res.body.estado).to.equal("no_disponible");
  });
}
