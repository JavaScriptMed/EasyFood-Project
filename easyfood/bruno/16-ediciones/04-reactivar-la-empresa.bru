meta {
  name: Reactivar la empresa
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/empresas/{{empresaNuevaId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "activo": true
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("vuelve a estar activa", function () {
    expect(res.body.activo).to.equal(true);
  });
}
