meta {
  name: Desactivar la empresa
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/admin/empresas/{{empresaNuevaId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("queda inactiva", function () {
    expect(res.body.activo).to.equal(false);
  });
}

docs {
  Nada se borra: la empresa queda inactiva y se puede reactivar.
}
