meta {
  name: Volver a ofrecer el platillo (admin)
  type: http
  seq: 28
}

patch {
  url: {{baseUrl}}/api/v1/admin/platillos/{{platilloNuevoId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "activo": true
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("vuelve a estar activo", function () {
    expect(res.body.activo).to.equal(true);
  });
}
