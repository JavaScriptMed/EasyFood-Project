meta {
  name: El comedor quita su platillo
  type: http
  seq: 29
}

patch {
  url: {{baseUrl}}/api/v1/comedor/platillos/{{platilloComedorNuevoId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenComedor}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("queda inactivo", function () {
    expect(res.body.activo).to.equal(false);
  });
}
