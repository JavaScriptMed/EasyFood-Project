meta {
  name: Editar a una persona con acceso
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/api/v1/cuentas/usuarios-acceso/{{usuarioInvitadoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "Persona Editada",
    "rol": "soporte"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("cambió el nombre y no es titular", function () {
    expect(res.body.nombre).to.equal("Persona Editada");
    expect(res.body.es_principal).to.equal(false);
  });
}

docs {
  La persona invitada en la carpeta 14. El rol debe corresponder a su organización (aquí, la plataforma).
}
