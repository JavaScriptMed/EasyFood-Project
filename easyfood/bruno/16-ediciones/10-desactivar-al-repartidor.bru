meta {
  name: Desactivar al repartidor
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v1/admin/repartidores/{{repartidorNuevoId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("queda inactivo y no disponible", function () {
    expect(res.body.activo).to.equal(false);
    expect(res.body.estado).to.equal("no_disponible");
  });
}

docs {
  Si tiene rutas por hacer responde 422 `repartidor_con_rutas`: primero se reasignan.
}
