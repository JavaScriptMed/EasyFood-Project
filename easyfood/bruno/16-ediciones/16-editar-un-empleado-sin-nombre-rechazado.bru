meta {
  name: Editar un empleado sin nombre (rechazado)
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/api/v1/empresa/empleados/{{empleadoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpresa}}
}

body:json {
  {
    "nombre": ""
  }
}

tests {
  test("responde 422", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.errores).to.have.property("nombre");
  });
}
