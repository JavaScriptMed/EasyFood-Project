meta {
  name: Editar un empleado
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/v1/empresa/empleados/{{empleadoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpresa}}
}

body:json {
  {
    "nombre": "{{empleadoNombre}}",
    "departamento": "Calidad"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("cambió el departamento", function () {
    expect(res.body.departamento).to.equal("Calidad");
  });
}
