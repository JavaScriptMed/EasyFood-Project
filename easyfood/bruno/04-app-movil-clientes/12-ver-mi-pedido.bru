meta {
  name: Ver mi pedido
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/cliente/pedidos/{{pedidoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("trae sus días", function () {
    expect(res.body.dias.length).to.equal(1);
  });
}
