meta {
  name: Guardar dirección dentro de una zona
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/cliente/direcciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "etiqueta": "Prueba",
    "direccion": "Av. López Mateos 2375",
    "numero_interior": "12",
    "codigo_postal": "44100",
    "latitud": 20.676,
    "longitud": -103.347,
    "referencias": "Timbre rojo"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("direccionNuevaId", res.body.id);
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("tiene cobertura y zona", function () {
    expect(res.body.sin_cobertura).to.equal(false);
    expect(res.body.zona).to.equal("Centro");
  });
}
