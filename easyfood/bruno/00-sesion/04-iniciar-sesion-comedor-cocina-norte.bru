meta {
  name: Iniciar sesión · comedor (Cocina Norte)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{correoComedor}}",
    "password": "{{contrasena}}"
  }
}

script:post-response {
  bru.setVar("tokenComedor", res.body.token);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("trae el token", function () {
    expect(res.body.token).to.be.a("string");
  });
}

docs {
  Inicia sesión y guarda el token en `tokenComedor`. Usa la contraseña definida en el entorno (la misma de SEED_PASSWORD).
}
