meta {
  name: Iniciar sesión · soporte
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{correoSoporte}}",
    "password": "{{contrasena}}"
  }
}

script:post-response {
  bru.setVar("tokenSoporte", res.body.token);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("trae el token", function () {
    expect(res.body.token).to.be.a("string");
  });
}

docs {
  Inicia sesión y guarda el token en `tokenSoporte`. Usa la contraseña definida en el entorno (la misma de SEED_PASSWORD).
}
