meta {
  name: Ver un cliente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/clientes/{{clienteId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSoporte}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("con sus pedidos y tickets", function () {
    expect(res.body.pedidos).to.be.an("array");
    expect(res.body.tickets).to.be.an("array");
  });
}
