meta {
  name: Cerrar el ticket
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/v1/admin/tickets/{{ticketId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSoporte}}
}

body:json {
  {
    "estado": "cerrado"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("el ticket queda cerrado", function () {
    expect(res.body.estado).to.equal("cerrado");
    expect(res.body).to.have.property("folio");
  });
}
