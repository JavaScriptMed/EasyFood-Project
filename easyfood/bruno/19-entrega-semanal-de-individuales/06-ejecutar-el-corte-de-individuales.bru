meta {
  name: Ejecutar el corte de individuales
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/admin/cortes/individuales/ejecutar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  { "fecha_entrega": "{{sabadoDeEntrega}}" }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("es el corte de individuales de ese sábado", function () {
    expect(res.body.corte.tipo).to.equal("individuales");
    expect(res.body.fecha_entrega).to.equal(bru.getVar("sabadoDeEntrega"));
    expect(res.body.sin_cambios).to.equal(false);
    expect(res.body.corte.estado).to.be.oneOf(["correcto", "con_advertencias"]);
  });
}

docs {
  Cierra los pedidos de clientes individuales de ese sábado: cancela los que siguen sin pagar (el pedido de la carpeta nunca se pagó), suma las porciones de los pagados a la orden de producción y arma sus rutas, separadas de las de empresas. Normalmente lo hace el sistema solo el sábado a la hora de corte; a mano se puede adelantar.
}
