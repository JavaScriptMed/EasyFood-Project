meta {
  name: Repetir el corte de individuales no cambia nada
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/cortes/individuales/ejecutar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  { "fecha_entrega": "{{sabadoDeEntrega}}" }
}

tests {
  test("responde 200 sin cambios", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.sin_cambios).to.equal(true);
    expect(res.body.rutas_creadas).to.equal(0);
  });
}
