meta {
  name: Mi menú (próxima entrega)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/empleado/menu
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpleado}}
}

script:post-response {
  if (res.status === 200 && res.body.opciones.length) { bru.setVar("opcionA", res.body.opciones[0].platillo.id); bru.setVar("opcionB", (res.body.opciones[1] || res.body.opciones[0]).platillo.id); bru.setVar("fechaMenu", res.body.fecha); }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("abierto, con opciones y precio", function () {
    expect(res.body.cerrado).to.equal(false);
    expect(res.body.opciones.length).to.be.greaterThan(0);
    expect(res.body.precio).to.equal(130);
    expect(res.body.empresa_cubre + res.body.empleado_paga).to.equal(130);
  });
}

docs {
  La fecha es la próxima con el corte abierto (lunes a sábado, corte a las 18:00 del día anterior). Trae lo que cubre la empresa (subsidio) y lo que paga el empleado.
}
