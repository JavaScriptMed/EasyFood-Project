meta {
  name: Agregar empleados sin lista (rechazado)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/empresa/empleados
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpresa}}
}

body:json {
  {
    "personas": []
  }
}

tests {
  test("responde 422", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.errores).to.have.property("personas");
  });
}
