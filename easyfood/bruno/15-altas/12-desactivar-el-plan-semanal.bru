meta {
  name: Desactivar el plan semanal
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/admin/paquetes/{{planSemanaId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
