meta {
  name: Repartidor en bicicleta (rechazado)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/repartidores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "Repartidor en bici",
    "correo": "bici@bruno.test",
    "tipo_vehiculo": "bicicleta",
    "placas": "SINPLACAS",
    "zona_base": "Centro"
  }
}

tests {
  test("responde 422 solo_automovil", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.codigo).to.equal("solo_automovil");
  });
}
