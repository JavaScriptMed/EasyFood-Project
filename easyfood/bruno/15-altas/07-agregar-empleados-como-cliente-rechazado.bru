post {
  url: {{baseUrl}}/api/v1/empresa/empleados
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenCliente}}
}

body:json {
  {
    "personas": [ { "nombre": "Nadie" } ]
  }
}

