meta {
  name: Aceptar con contraseña débil (rechazado)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/cuentas/invitaciones/{{tokenInvitacion}}/aceptar
  body: json
  auth: none
}

body:json {
  {
    "contrasena": "corta"
  }
}

tests {
  test("responde 422 con el motivo", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.mensaje).to.be.a("string");
  });
}
