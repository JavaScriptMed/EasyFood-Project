meta {
  name: Invitar a una persona
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/cuentas/invitaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "organizacion_tipo": "plataforma",
    "nombre": "Persona de Bruno",
    "correo": "{{correoInvitado}}",
    "rol": "soporte"
  }
}

script:pre-request {
  bru.setVar("correoInvitado", "bruno." + Date.now() + "@easylunch.test");
}

script:post-response {
  if (res.status === 201) bru.setVar("invitacionId", res.body.invitacion.id);
  if (res.status === 201) bru.setVar("usuarioInvitadoId", res.body.invitacion.usuario_id);
}

tests {
  test("responde 201: cuenta inactiva con invitación enviada", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.activo).to.equal(false);
    expect(res.body.invitacion.estado).to.equal("enviada");
  });

  test("la API no devuelve el enlace", function () {
    expect(res.body.invitacion.token).to.equal("");
  });
}

docs {
  Crea la cuenta (inactiva) y manda el correo con el enlace. El correo es nuevo en cada corrida (`correoInvitado`). El enlace está en `storage/logs/enlaces.log`.
}
