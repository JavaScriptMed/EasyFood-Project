meta {
  name: Marcar las órdenes como listas
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/comedor/produccion/marcar-listas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenComedor}}
}

body:json {
  {
    "fecha": "{{fechaCortada}}"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("marcó las pendientes", function () {
    expect(res.body.marcadas).to.be.greaterThan(-1);
  });
}
