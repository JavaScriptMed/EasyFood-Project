meta {
  name: Generar rutas sin corte (rechazado)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/admin/rutas/generar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "fecha": "2035-01-02"
  }
}

tests {
  test("responde 422 corte_pendiente", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.codigo).to.equal("corte_pendiente");
  });
}
