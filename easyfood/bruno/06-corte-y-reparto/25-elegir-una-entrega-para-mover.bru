meta {
  name: Elegir una entrega para mover
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/admin/rutas?fecha={{fechaCortada}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200 && res.body.length) {
    const ruta = res.body.find((r) => r.paradas.length) || res.body[0];
    bru.setVar("rutaDeLaEntrega", ruta.id);
    bru.setVar("entregaPorMover", ruta.paradas[0].id);
  }
}

tests {
  test("responde 200 con una entrega para mover", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getVar("entregaPorMover")).to.be.a("number");
  });
}
