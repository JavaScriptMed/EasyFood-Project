meta {
  name: Candidatos de una incidencia ya resuelta (rechazado)
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v1/admin/incidencias/{{incidenciaId}}/candidatos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 422 incidencia_cerrada", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.codigo).to.equal("incidencia_cerrada");
  });
}

docs {
  Solo se reasigna la ruta de una incidencia abierta ligada a una ruta; la que acabamos de resolver ya no cuenta.
}
