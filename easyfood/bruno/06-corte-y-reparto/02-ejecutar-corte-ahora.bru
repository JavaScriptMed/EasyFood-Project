meta {
  name: Ejecutar corte ahora
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/cortes/ejecutar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200) bru.setVar("fechaCortada", res.body.fecha_entrega);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("cerró elecciones y generó lo del día", function () {
    expect(res.body.corte.estado).to.be.oneOf(["correcto", "con_advertencias"]);
    expect(res.body.elecciones_cerradas).to.be.greaterThan(0);
    expect(res.body.entregas_consolidadas).to.be.greaterThan(0);
  });
}

docs {
  Corta la primera fecha de servicio que todavía no se ha cortado: cierra las elecciones, aplica la regla a quien no eligió, genera una orden por comedor, consolida una entrega por empresa y crea rutas por zona sin pasar la capacidad del auto. Es idempotente: ejecutarlo otra vez para la misma fecha no cambia nada.
}
