meta {
  name: Después del corte ya no se puede elegir
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/empleado/elecciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpleado}}
}

body:json {
  {
    "fecha": "{{fechaCortada}}",
    "tiempo_comida": "comida",
    "platillo_id": "{{opcionB}}"
  }
}

tests {
  test("responde 422", function () {
    expect(res.getStatus()).to.equal(422);
  });

  test("corte cerrado", function () {
    expect(res.body.codigo).to.equal("corte_cerrado");
  });
}
