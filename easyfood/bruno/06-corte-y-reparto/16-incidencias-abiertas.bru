meta {
  name: Incidencias abiertas
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/admin/incidencias?abiertas=1
  body: none
  auth: bearer
}

params:query {
  abiertas: 1
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200 && res.body.length) bru.setVar("incidenciaId", res.body[0].id);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("las inmediatas van primero", function () {
    if (res.body.length > 1 && res.body[0].prioridad !== "inmediata") { expect(res.body.every(i => i.prioridad === "normal")).to.equal(true); }
  });
}

docs {
  Si una entrega queda sin ruta por falta de repartidores, el corte abre una incidencia `falta_repartidores` automáticamente.
}
