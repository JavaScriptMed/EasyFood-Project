meta {
  name: Rutas del día (con paradas)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/admin/rutas?fecha={{fechaCortada}}
  body: none
  auth: bearer
}

params:query {
  fecha: {{fechaCortada}}
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("rutas por zona con sus paradas", function () {
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0].paradas.length).to.be.greaterThan(0);
    expect(res.body[0].entregas_asignadas).to.be.at.most(res.body[0].capacidad_entregas);
  });
}

docs {
  Las rutas se arman por zona. En cada zona van primero las entregas a empresas y después las de clientes individuales.
}
