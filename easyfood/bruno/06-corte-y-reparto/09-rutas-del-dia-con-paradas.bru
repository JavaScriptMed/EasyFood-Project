meta {
  name: Rutas del día (con paradas)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/admin/rutas?fecha={{fechaCortada}}
  body: none
  auth: bearer
}

params:query {
  fecha: {{fechaCortada}}
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("rutas por zona con sus paradas", function () {
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0].paradas.length).to.be.greaterThan(0);
    expect(res.body[0].entregas_asignadas).to.be.at.most(res.body[0].capacidad_entregas);
  });

  test("cada parada trae la foto de evidencia y el motivo de no entrega (null si no aplican)", function () {
    res.body.forEach((ruta) => ruta.paradas.forEach((parada) => {
      expect(parada).to.have.property("evidencia_foto_url");
      expect(parada).to.have.property("motivo_no_entrega");
      if (parada.estado === "entregado") expect(parada.evidencia_foto_url).to.be.a("string");
      if (parada.estado === "no_localizado") expect(parada.motivo_no_entrega).to.be.a("string");
      if (parada.estado === "pendiente") { expect(parada.evidencia_foto_url).to.equal(null); expect(parada.motivo_no_entrega).to.equal(null); }
    }));
  });
}

docs {
  Las rutas se arman por zona. En cada zona van primero las entregas a empresas y después las de clientes individuales.
}
