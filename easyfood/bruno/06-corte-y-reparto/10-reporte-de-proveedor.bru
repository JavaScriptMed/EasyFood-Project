meta {
  name: Reporte de proveedor
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/admin/reportes/proveedor?fecha={{fechaCortada}}
  body: none
  auth: bearer
}

params:query {
  fecha: {{fechaCortada}}
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("porciones y costo por comedor", function () {
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0]).to.have.property("costo_total");
  });
}

docs {
  Lo que se le pide a cada comedor ese día y cuánto cuesta (porciones × el precio de su contrato).
}
