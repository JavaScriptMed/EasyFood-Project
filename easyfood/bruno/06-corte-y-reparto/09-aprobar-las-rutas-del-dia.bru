meta {
  name: Aprobar las rutas del día
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/admin/rutas/aprobar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "fecha": "{{fechaCortada}}"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
