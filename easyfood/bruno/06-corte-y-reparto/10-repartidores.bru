meta {
  name: Repartidores
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/admin/repartidores
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

script:post-response {
  if (res.status === 200 && res.body.length) bru.setVar("repartidorId", res.body[0].id);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("solo autos", function () {
    expect(res.body[0].tipo_vehiculo).to.equal("automovil");
  });
}
