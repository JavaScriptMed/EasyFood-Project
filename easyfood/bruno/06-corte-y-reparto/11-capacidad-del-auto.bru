meta {
  name: Capacidad del auto
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/admin/repartidores/capacidades
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("30 entregas y 120 platillos", function () {
    expect(res.body.entregas).to.equal(30);
    expect(res.body.platillos).to.equal(120);
  });
}
