meta {
  name: Producción del comedor
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/comedor/produccion?fecha={{fechaCortada}}
  body: none
  auth: bearer
}

params:query {
  fecha: {{fechaCortada}}
}

auth:bearer {
  token: {{tokenComedor}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("una orden por platillo", function () {
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0].porciones_totales).to.be.greaterThan(0);
  });
}

docs {
  Las órdenes de producción que generó el corte para tu comedor, con la hora de recolección (90 minutos antes de la primera ventana de entrega).
}
