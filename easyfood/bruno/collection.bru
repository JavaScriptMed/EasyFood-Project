headers {
  Accept: application/json
  Content-Type: application/json
}

script:pre-request {
  // Fechas de la prueba, calculadas con la hora de tu computadora (se asume hora de México, como el servidor).
  const f = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const suma = (d, n) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
  const ahora = new Date();
  const hoy = new Date(ahora.getFullYear(), ahora.getMonth(), ahora.getDate());
  // Próxima fecha de entrega con el corte abierto: lunes a sábado, y el corte es a las 18:00 del día anterior.
  let entrega = suma(hoy, 1);
  const corteDe = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate() - 1, 18, 0, 0);
  while (entrega.getDay() === 0 || ahora >= corteDe(entrega)) entrega = suma(entrega, 1);
  const noDomingo = (d) => (d.getDay() === 0 ? suma(d, 1) : d);
  const mesPasado = new Date(hoy.getFullYear(), hoy.getMonth() - 1, 1);
  bru.setVar("hoy", f(hoy));
  bru.setVar("enSieteDias", f(suma(hoy, 7)));
  bru.setVar("fechaEntrega", f(entrega));
  bru.setVar("mesActual", f(hoy).slice(0, 7));
  bru.setVar("mesPasado", f(mesPasado).slice(0, 7));
  bru.setVar("fechaFestivoPrueba", f(noDomingo(suma(hoy, 40))));
  bru.setVar("fechaCierrePrueba", f(noDomingo(suma(hoy, 45))));
}

docs {
  # EasyLunch API v1
  Colección para probar el backend a mano. Lee `bruno/README.md` para empezar:
  1. Carga los datos de ejemplo (`php artisan db:seed --class=DatosDeEjemploSeeder`).
  2. Elige el entorno **Local** y escribe la contraseña (la de SEED_PASSWORD) en la variable secreta `contrasena`.
  3. Corre la carpeta **Sesión** y después las demás en orden (clic derecho → Run).
}
