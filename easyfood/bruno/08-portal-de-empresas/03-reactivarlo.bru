meta {
  name: Reactivarlo
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/empresa/empleados/{{empleadoNexoId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpresa}}
}

body:json {
  {
    "activo": true
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("queda activo", function () {
    expect(res.body.activo).to.equal(true);
  });
}
