meta {
  name: Desactivar a un empleado
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/empresa/empleados/{{empleadoNexoId}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpresa}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("queda inactivo", function () {
    expect(res.body.activo).to.equal(false);
  });
}

docs {
  Un empleado inactivo no puede elegir platillo ni recibe platillo por defecto.
}
