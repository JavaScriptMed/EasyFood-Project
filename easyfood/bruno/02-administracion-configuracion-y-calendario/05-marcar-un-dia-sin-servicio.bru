meta {
  name: Marcar un día sin servicio
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/calendario/dias-sin-servicio
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "fecha": "{{fechaFestivoPrueba}}",
    "tipo": "festivo",
    "motivo": "Festivo de prueba (Bruno)"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("diaSinServicioId", res.body.id);
}

tests {
  test("responde 201 o 422", function () {
    expect([201, 422]).to.include(res.getStatus());
  });
}

docs {
  Solo fechas futuras cuyo corte no se haya ejecutado. Repetirlo para la misma fecha responde 422 `dia_ya_marcado`; la siguiente petición lo quita.
}
