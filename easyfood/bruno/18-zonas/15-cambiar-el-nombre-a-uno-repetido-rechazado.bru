meta {
  name: Cambiar el nombre a uno que ya existe (rechazado)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/admin/zonas/{{zonaNuevaId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "centro"
  }
}

tests {
  test("responde 422 zona_repetida (sin importar mayúsculas)", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.body.codigo).to.equal("zona_repetida");
  });
}
