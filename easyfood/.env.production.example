# EasyLunch · variables de PRODUCCIÓN. Copia este archivo a .env.production en el servidor y llena cada valor.
# No lo subas al repositorio (.env.production está en .gitignore). Aquí no hay valores reales.

# ---------------------------------------------------------------- aplicación
APP_NAME=EasyLunch
APP_ENV=production
# Genera una con:  docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
# Siempre false en producción: con true la API enseñaría detalles internos en los errores.
APP_DEBUG=false
# Dirección pública de la API (con https), la misma que atiende tu proxy.
APP_URL=
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
BCRYPT_ROUNDS=12

# Puerto local donde publica el contenedor web (solo 127.0.0.1).
WEB_PORT=8080   # (lo lee docker compose: usa siempre --env-file .env.production, ver DESPLIEGUE.md)

# ---------------------------------------------------------------- front (CORS)
# Dominio(s) del front, separados por coma y sin barra final. Ejemplo: https://tu-proyecto.vercel.app
CORS_ALLOWED_ORIGINS=
# Dirección del front, para los enlaces de los correos (invitaciones y restablecer contraseña).
FRONTEND_URL=
CORS_SUPPORTS_CREDENTIALS=false
# El proxy del servidor está delante de la app: para que las limitaciones de peticiones cuenten por IP real del cliente.
# «*» confía en el proxy que le pasa el tráfico (la app solo es alcanzable desde él, porque el puerto está en 127.0.0.1).
TRUSTED_PROXIES=*
# Vistas previas de Vercel (opcional): expresión regular, varias separadas por coma. Ejemplo: #^https://mi-proyecto-[a-z0-9-]+\.vercel\.app$#
CORS_ALLOWED_ORIGINS_PATTERNS=

# ---------------------------------------------------------------- base de datos (PostgreSQL del servidor, con PostGIS)
DB_CONNECTION=pgsql
# host.docker.internal = el servidor donde corre Docker. También puede ser su IP.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=America/Mexico_City

# ---------------------------------------------------------------- sesiones, caché y cola (todo en la base)
# Minutos de vida de un token de acceso (10080 = 7 días). Al vencer, la persona vuelve a iniciar sesión.
SANCTUM_EXPIRATION=10080
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ---------------------------------------------------------------- logs
# Archivo diario (en el volumen storage, 14 días) y también a la consola del contenedor (docker logs).
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# ---------------------------------------------------------------- correo (invitaciones y restablecer contraseña)
# Con «log» los correos NO salen: solo para pruebas. En producción usa smtp con tu proveedor.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Stripe (claves de PRODUCCIÓN, no las de prueba)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
