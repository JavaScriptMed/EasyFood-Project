# Variables del front de EasyLunch. Se leen en el NAVEGADOR (por eso empiezan con NEXT_PUBLIC_): no pongas aquí nada secreto.
#
# En local: copia este archivo a .env.local.
# En Vercel: Project Settings → Environment Variables (entorno Production y Preview).

# URL del backend de EasyLunch (la API de Laravel), con https y sin barra final.
#   local (Docker):  http://localhost:8000
#   producción:      https://api.tu-dominio.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = pantallas con datos de ejemplo y SIN backend (útil para diseñar o enseñar sin servidor).
# false (o sin definir) = usa el backend real. En producción debe ser false.
NEXT_PUBLIC_USAR_MOCK=false
